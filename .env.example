# Supabase — project URL and anon key (safe for the browser)
# Find both in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Supabase service role key — SERVER ONLY, never prefix with NEXT_PUBLIC_
# Find it in Supabase Dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
